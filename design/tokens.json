{
  "$note": "The visual law. Every SVG value derives from these tokens \u2014 no inline magic numbers in lib/render. Revised only through the beauty loop; changes logged in BEAUTY_LOG.md.",
  "color": {
    "paper": "#F7F6F2",
    "block": {
      "parcel": "#EFECE4",
      "parcelStroke": "#E2DED4",
      "building": "#E8E5DC",
      "buildingStroke": "#D9D5CA"
    },
    "sidewalk": "#F3F1EB",
    "roadbed": {
      "asphalt": "#FBFAF7",
      "pavers": "#F4EEE3",
      "cobbles": "#F0EBE1"
    },
    "parkingBand": "#F1EFE8",
    "curb": "#D6D2C7",
    "marking": {
      "laneLine": "#C9C5BA",
      "crosswalk": "#FFFFFF"
    },
    "green": {
      "canopy": "#CFE2BE",
      "canopyExisting": "#BCD4AD",
      "canopyCore": "#A3BF93",
      "planting": "#DCE8CF",
      "trunk": "#8A8371"
    },
    "reclaimed": {
      "open": "#F2EEE2",
      "seating": "#EFE9DA",
      "parklet": "#EDE6D2",
      "island": "#E4EAD8",
      "gateway": "#EFEAD9"
    },
    "bikeLane": "#E3EBE2",
    "people": "#8F8A7E",
    "vehicle": "#CBC7BE",
    "label": {
      "street": "#A29E94",
      "cross": "#B0ACA2",
      "badge": "#6E6A61",
      "badgeSchool": "#B58A3A"
    },
    "accent": {
      "danger": "#C0554D",
      "ok": "#5E8C61"
    }
  },
  "stroke": {
    "hairline": 0.5,
    "fine": 0.75,
    "curb": 1.1,
    "buildingEdge": 0.6,
    "laneDash": 1.0,
    "loadingDash": [
      3,
      2.5
    ]
  },
  "dash": {
    "laneLine": [
      6,
      6
    ]
  },
  "radius": {
    "curbCornerMin": 1.5,
    "islandEnd": 2.0,
    "parkletCorner": 0.8,
    "buildingCorner": 0.5
  },
  "shadow": {
    "building": {
      "dx": 0,
      "dy": 1.1,
      "blur": 1.6,
      "color": "#00000014"
    }
  },
  "type": {
    "family": "'SF Pro Text', -apple-system, 'Helvetica Neue', system-ui, sans-serif",
    "street": {
      "size": 11,
      "weight": 500,
      "tracking": 1.6,
      "transform": "uppercase"
    },
    "cross": {
      "size": 9,
      "weight": 500,
      "tracking": 1.2,
      "transform": "uppercase"
    },
    "badge": {
      "size": 8,
      "weight": 600,
      "tracking": 0.8
    }
  },
  "furniture": {
    "treeCanopyRadiusM": {
      "min": 2.2,
      "existingFromDbhFactor": 0.28,
      "newMin": 1.5,
      "newMax": 2.2,
      "newJitterM": 0.4
    },
    "trunkRadiusM": 0.22,
    "personRadiusM": 0.42,
    "carLengthM": 4.6,
    "carWidthM": 1.85,
    "parkingSpaceLengthM": 6.1,
    "parkingBandDepthM": 2.2,
    "benchLengthM": 1.8,
    "benchWidthM": 0.55,
    "bikeLaneInsetM": 0.3
  },
  "scale": {
    "pxPerMeter": 4.5,
    "marginM": 6
  }
}
